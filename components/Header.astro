---
// Site header shared by Kyle's sites. The wordmark goes home; `links` is the nav.
// kylepace.net: <Header name="Kyle Pace" links={...} />
// kylepace.dev and its experiments: <Header name="kylepace" suffix=".dev" mono href="https://kylepace.dev/" links={...} />
// `sites` adds a small switch beside the wordmark for jumping between Kyle's sites
// (SITES in lib/sites.ts). It's links, not a toggle button, because each half goes to another site.
interface Props {
  /** The wordmark. */
  name: string;
  /** Optional part of the wordmark shown in the accent color, like ".dev". */
  suffix?: string;
  /** Set the wordmark in Atkinson Hyperlegible Mono. */
  mono?: boolean;
  /** Where the wordmark links. */
  href?: string;
  /**
   * Nav links. `emphasis` shows one in the accent color (a resume, the other site).
   * `hint` is extra text for screen readers only, like " (PDF)".
   */
  links: { href: string; label: string; emphasis?: boolean; hint?: string }[];
  /**
   * The site switch. `label` is what shows (".net"), `name` is what screen readers hear
   * ("kylepace.net"). Mark the site you're on with `current`.
   */
  sites?: { href: string; label: string; name: string; current?: boolean }[];
}

const { name, suffix, mono = false, href = '/', links, sites = [] } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (link: string) => {
  try {
    const url = new URL(link, Astro.url);
    return url.host === Astro.url.host && url.pathname !== '/' && path.startsWith(url.pathname);
  } catch {
    return false;
  }
};
---

<header class="site-header">
  <div class="brand">
    <a class:list={['name', { mono }]} href={href}>{name}{suffix && <span class="suffix">{suffix}</span>}</a>
    {
      sites.length > 1 && (
        <nav class="sites" aria-label="Kyle’s sites">
          <ul>
            {sites.map((site) => (
              <li>
                <a href={site.href} aria-current={site.current ? 'true' : undefined}>
                  <span aria-hidden="true">{site.label}</span>
                  <span class="visually-hidden">
                    {site.name}
                    {site.current && ', current site'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
  <nav aria-label="Main">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} class:list={{ emphasis: link.emphasis }} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
              {link.hint && <span class="visually-hidden">{link.hint}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    width: min(100% - 2 * var(--space-6), var(--wide));
    margin-inline: auto;
    padding-block: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: baseline;
    justify-content: space-between;
    view-transition-name: site-header;
  }

  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  .name.mono {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .suffix {
    color: var(--accent-ink);
  }

  /* The site switch: a small pill of two links; the current site is filled. */
  .sites ul {
    gap: 0;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .sites a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    min-width: 2.75rem;
    justify-content: center;
    padding: 0 var(--space-3);
    border-radius: 999px;
    color: var(--ink-muted);
    text-decoration: none;
  }

  /* Each half's tap area reaches 44px tall without making the pill look bigger. */
  .sites a::after {
    content: '';
    position: absolute;
    inset: -0.375rem 0;
  }

  .sites a:hover {
    color: var(--ink);
  }

  .sites a[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  /* High-contrast modes drop the fill, so the current site gets an outline instead. */
  @media (forced-colors: active) {
    .sites a[aria-current='true'] {
      outline: 2px solid CanvasText;
      outline-offset: -2px;
    }
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a.emphasis {
    color: var(--accent-ink);
    font-weight: 600;
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.15em;
    text-underline-offset: 0.35em;
  }
</style>
