---
// "About this project": the one obvious way into a project's About page. LabLayout puts it
// in the top bar when given `about`; pages with their own layout (World cuisine) can place
// it wherever their intro is. It takes the page's own ink, so it fits any lab's look.
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="about-link" href={href}>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
    <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="10" cy="6.25" r="1.25" fill="currentColor"></circle>
    <path d="M10 9v5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
  </svg>
  <span>About<span class="more"> this project</span></span>
</a>

<style>
  /* A real button-sized link: outlined in the page's ink, filled a little on hover. */
  .about-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4) 0 var(--space-3);
    border: 1.5px solid color-mix(in srgb, var(--ink) 55%, transparent);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  svg {
    flex: none;
  }

  .about-link:hover {
    border-color: var(--ink);
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* On the narrowest phones it says just "About", so it never pushes past the edge. */
  @media (max-width: 24rem) {
    .more {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-link {
      transition:
        background-color var(--duration-fast, 150ms) ease-out,
        border-color var(--duration-fast, 150ms) ease-out;
    }
  }
</style>
