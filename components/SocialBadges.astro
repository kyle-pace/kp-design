---
// Badges in the footer: LinkedIn, GitHub and Mastodon profiles, plus the site's RSS feed
// when the site passes one in (`rssHref`).
// Logos are each brand's official files, unaltered, in src/assets/brands/ named
// after the profile (SVG or PNG). SVGs are inlined so a one-color mark (GitHub)
// can follow the theme; a badge only appears once its logo file is there.
// Sources: LinkedIn In-Bug (brand.linkedin.com), GitHub mark (@primer/octicons),
// Mastodon logo (mastodon/mastodon repo).
interface Props {
  /** The site's RSS feed. Leave it out on a site with no feed and no RSS badge shows. */
  rssHref?: string;
}
const { rssHref } = Astro.props;

// The standard feed icon (a dot and two arcs). It isn't a brand logo, so it's drawn here
// and takes the text color in both themes.
const rssIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="5.5" cy="18.5" r="2.5"/><path d="M3 3v3.4c8.06 0 14.6 6.54 14.6 14.6H21C21 11.06 12.94 3 3 3z"/><path d="M3 9.5v3.4c4.47 0 8.1 3.63 8.1 8.1h3.4C14.5 14.65 9.35 9.5 3 9.5z"/></svg>';

const svgs = import.meta.glob<string>('../assets/brands/*.svg', { eager: true, query: '?raw', import: 'default' });
const pngs = import.meta.glob<{ default: { src: string } }>('../assets/brands/*.png', { eager: true });

const profiles = [
  { name: 'linkedin', label: 'Kyle Pace on LinkedIn', href: 'https://www.linkedin.com/in/kylepacepm' },
  { name: 'github', label: 'Kyle Pace on GitHub', href: 'https://github.com/kyle-pace' },
  { name: 'mastodon', label: 'Kyle Pace on Mastodon', href: 'https://mastodon.social/@kylepace' },
]
  .map((p) => ({
    ...p,
    svg: svgs[`../assets/brands/${p.name}.svg`],
    png: pngs[`../assets/brands/${p.name}.png`]?.default.src,
  }))
  .filter((p) => p.svg || p.png);

// rel="me" tells other sites (Mastodon, for one) that a profile is Kyle's. A feed isn't a
// profile, so it gets type="application/rss+xml" instead, which feed readers look for.
const badges = [
  ...profiles.map((p) => ({ ...p, rel: 'me', type: undefined })),
  ...(rssHref
    ? [{ name: 'rss', label: 'RSS feed', href: rssHref, svg: rssIcon, png: undefined, rel: undefined, type: 'application/rss+xml' }]
    : []),
];
---

{
  badges.length > 0 && (
    <ul class="badges" aria-label={rssHref ? 'Profiles and feed' : 'Profiles'}>
      {badges.map((p) => (
        <li>
          <a class="badge" href={p.href} rel={p.rel} type={p.type} aria-label={p.label}>
            {p.svg ? <span class="logo" aria-hidden="true" set:html={p.svg} /> : <img class="logo" src={p.png} alt="" />}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .badges {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
  }

  .logo,
  .logo :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  /* One-color marks (GitHub, RSS) take the text color, so they work in both themes. */
  .logo :global(svg) {
    fill: currentColor;
  }

  @media (hover: hover) and (pointer: fine) {
    .badge {
      transition: border-color var(--duration-fast) var(--ease-out);
    }

    .badge:hover {
      border-color: var(--accent);
    }
  }
</style>
