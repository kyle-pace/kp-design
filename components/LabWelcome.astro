---
// The first-visit welcome for a lab: a short dialog that says what the experiment is and
// who made it, shown once per lab per browser (remembered in localStorage) and never to
// bots. LabLayout shows it when given `welcome`; pages with their own layout (World
// cuisine) can place it themselves.
//
// It's a native <dialog> opened with showModal(): focus moves into it and back after,
// Escape closes it, the page behind can't be reached, and screen readers announce it.
interface Props {
  /** The lab's name, as listed ("World transit"). */
  name: string;
  /** One to three plain sentences: what it is and what to try first. */
  text: string;
  /** The lab's About page, for a "How it works" link. */
  about?: string;
  /** What to remember the visit by; defaults to the lab's name. */
  storageKey?: string;
}

const { name, text, about, storageKey = name } = Astro.props;
---

<dialog class="lab-welcome" aria-labelledby="lab-welcome-title" data-lab-welcome={`kp-welcome:${storageKey}`}>
  <form method="dialog">
    <h2 id="lab-welcome-title">Welcome to {name}</h2>
    <p class="lab-welcome-text">{text}</p>
    <p class="lab-welcome-by">
      Made by <a href="https://kylepace.net/about/">Kyle Pace</a>, a product manager who designs and builds small, free
      things after hours.
    </p>
    <div class="lab-welcome-actions">
      <button type="submit" value="explore" autofocus>Start exploring</button>
      {about && <a href={about}>How it works</a>}
    </div>
  </form>
</dialog>

<script>
  import { isAutomated } from '../lib/analytics';

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-lab-welcome]')) {
    const key = dialog.dataset.labWelcome!;
    let seen = false;
    try {
      seen = localStorage.getItem(key) !== null;
    } catch {
      seen = true; // no storage (private mode): don't nag on every visit
    }
    if (seen || isAutomated() || typeof dialog.showModal !== 'function') continue;
    dialog.showModal();
    const remember = () => {
      try {
        localStorage.setItem(key, new Date().toISOString());
      } catch {
        // nothing to do
      }
    };
    dialog.addEventListener('close', remember);
    // A click on the dimmed page around the dialog closes it too.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .lab-welcome {
    width: min(30rem, calc(100% - 2 * var(--gutter, 1rem)));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius, 0.5rem);
    background: var(--bg-raised, var(--bg));
    color: var(--ink);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
  }

  .lab-welcome::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .lab-welcome form {
    padding: var(--space-6) var(--space-6) var(--space-6);
  }

  .lab-welcome h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .lab-welcome-text {
    margin: 0 0 var(--space-4);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .lab-welcome-by {
    margin: 0 0 var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .lab-welcome a {
    color: var(--accent-ink, var(--accent));
    text-underline-offset: 0.15em;
  }

  .lab-welcome-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
  }

  .lab-welcome button {
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    border: 0;
    border-radius: var(--radius-sm, 0.375rem);
    /* Ink on the page color: readable in every lab and both modes, whatever its accent. */
    background: var(--ink);
    color: var(--bg);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .lab-welcome button:focus-visible,
  .lab-welcome a:focus-visible {
    outline: 3px solid var(--accent-ink, var(--accent));
    outline-offset: 2px;
  }

  .lab-welcome-actions a {
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lab-welcome[open] {
      animation: lab-welcome-in 200ms ease-out;
    }
  }

  @keyframes lab-welcome-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
</style>
