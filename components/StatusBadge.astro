---
// "Draft" or "In progress" pill. Renders nothing for published work.
export type Status = 'draft' | 'in-progress' | 'published';
const statusLabels: Record<Status, string> = { draft: 'Draft', 'in-progress': 'In progress', published: 'Published' };

interface Props {
  status: Status;
}

const { status } = Astro.props;
---

{status !== 'published' && <span class:list={['status', status]}>{statusLabels[status]}</span>}

<style>
  .status {
    display: inline-block;
    padding: 0.1em 0.6em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    line-height: 1.5;
    vertical-align: middle;
  }

  .in-progress {
    border: 1px solid var(--accent-ink);
    color: var(--accent-ink);
  }

  .draft {
    border: 1px dashed var(--ink);
    color: var(--ink);
  }
</style>
