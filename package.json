  "files": [
    "index.ts",
    "styles",
    "components",
    "layouts",
    "lib",
    "assets"
  ],
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@amplitude/analytics-browser": "^2.49.2",
    "@amplitude/plugin-session-replay-browser": "^1.36.7"
  },
  "peerDependencies": {
    "astro": ">=5"
  }
