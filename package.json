{
  "name": "kp-design",
  "version": "0.4.2",
  "description": "Kyle Pace's design system for his websites: tokens, Atkinson Hyperlegible type, display settings, header and footer.",
  "type": "module",
  "repository": "github:kyle-pace/kp-design",
  "exports": {
    ".": "./index.ts",
    "./tokens.css": "./styles/tokens.css",
    "./global.css": "./styles/global.css",
    "./components/*": "./components/*",
    "./analytics": "./lib/analytics.ts",
    "./kylepace-dev": "./lib/kylepace-dev.ts",
    "./sites": "./lib/sites.ts",
    "./layouts/*": "./layouts/*",
    "./lab.css": "./styles/lab.css",
    "./display-settings.css": "./styles/display-settings.css"
