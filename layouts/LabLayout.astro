---
// The page shell for a standalone experiment on kylepace.dev: its own page, not a page
// of the site. No site header or nav; a small "kylepace.dev" link back in the upper
// left, a one-line footer (privacy, accessibility, connections), the display settings
// and analytics. Everything else, including the look, belongs to the lab: it imports
// lab.css only (not global.css) and overrides the tokens to make itself its own.
//
// Slots: default (the page), "head" (extra <head> tags), "bar" (the right side of the
// top bar, e.g. a status badge or the lab's own links).
//
// The bar starts with "More labs by Kyle" (back to kylepace.dev/labs/). Pass `about` (the
// lab's About page) and it ends with a clear "About this project" button on every other
// page, so a first-time visitor can always find out what they're looking at. Pass `lab`
// too, and the About page ends with "Back to <lab name>" instead.
import '../styles/lab.css';
import DisplaySettings from '../components/DisplaySettings.astro';
import DisplaySettingsInit from '../components/DisplaySettingsInit.astro';
import AboutLink from '../components/AboutLink.astro';
import BarButton from '../components/BarButton.astro';

interface Props {
  title: string;
  description: string;
  /** Share image, as a path on kylepace.dev ("/transit/share.png") or a full URL. */
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Favicon path; defaults to kylepace.dev's. */
  favicon?: string;
  /** Browser UI color in light and dark mode. Defaults to the tokens' backgrounds. */
  themeColor?: { light: string; dark: string };
  /** Where the back link goes, and what it says. */
  backHref?: string;
  backLabel?: string;
  /** The lab's About page ("/transit/about/"). Shows the "About this project" button. */
  about?: string;
  /** The lab's name and main page. On the About page, shows "Back to <name>". */
  lab?: { name: string; href: string };
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  favicon = '/favicon.svg',
  themeColor = { light: '#fbf8f3', dark: '#141317' },
  backHref = 'https://kylepace.dev/labs/',
  backLabel = 'More labs by Kyle',
  about,
  lab,
  noindex = false,
} = Astro.props;

const trim = (p: string) => p.replace(/\/+$/, '');
const onAbout = !!about && trim(Astro.url.pathname) === trim(about);

const site = Astro.site ?? new URL('https://kylepace.dev');
const canonical = new URL(Astro.url.pathname, site);
// A lab's title stands on its own; the site name follows, so tabs still say where it lives.
const pageTitle = `${title} · kylepace.dev`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={favicon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kylepace.dev" />
    <meta property="og:image" content={new URL(image, site)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="fediverse:creator" content="@kylepace@mastodon.social" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <slot name="head" />
    <DisplaySettingsInit />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="lab-bar" aria-label="kylepace.dev">
      <BarButton href={backHref} icon="labs" label={backLabel} short="More labs" quiet />
      <div class="lab-bar-end">
        <slot name="bar" />
        {
          about && !onAbout && <AboutLink href={about} />
        }
        {
          onAbout && lab && <BarButton href={lab.href} icon="back" label={`Back to ${lab.name}`} short="Back" />
        }
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="lab-foot">
      <p>Made by <a href="https://kylepace.net/">Kyle Pace</a>.</p>
      <ul>
        <li><a href="https://kylepace.dev/privacy/">Privacy</a></li>
        <li><a href="https://kylepace.dev/accessibility/">Accessibility</a></li>
        <li><a href="https://kylepace.dev/connections/">What this connects to</a></li>
      </ul>
    </footer>
    <DisplaySettings accessibilityHref="https://kylepace.dev/accessibility/" />
    <script>
      import { startAnalytics } from '../lib/analytics';
      import { DEV_ANALYTICS } from '../lib/kylepace-dev';
      startAnalytics(DEV_ANALYTICS);
    </script>
  </body>
</html>

<style>
  /* On a narrow phone, a lab's own links and the About button wrap under the back link
     instead of pushing the page sideways. */
  .lab-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) var(--gutter);
  }


  .lab-bar-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    align-items: center;
    margin-inline-start: auto;
  }

  .lab-foot {
    padding: var(--space-8) var(--gutter) calc(var(--space-8) + 4rem);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .lab-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
  }

  .lab-foot p,
  .lab-foot ul {
    margin: 0;
  }

  .lab-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .lab-foot a {
    color: inherit;
  }
</style>
