---
// The page shell for a standalone experiment on kylepace.dev: its own page, not a page
// of the site. No site header or nav; a small "kylepace.dev" link back in the upper
// left, a one-line footer (privacy, accessibility, connections), the display settings
// and analytics. Everything else, including the look, belongs to the lab: it imports
// lab.css only (not global.css) and overrides the tokens to make itself its own.
//
// Slots: default (the page), "head" (extra <head> tags), "bar" (the right side of the
// top bar, e.g. a status badge or the lab's own links).
//
// The bar starts with "More labs by Kyle" (back to kylepace.dev/labs/). Pass `about` (the
// lab's About page) and it ends with a clear "About this project" button on every other
// page, so a first-time visitor can always find out what they're looking at. Pass `lab`
// too, and every page but the lab's main one starts with "Back to <lab name>", at the
// far left where back always is, with "More labs by Kyle" beside it. About pages end
// with a short "More labs" list (components/MoreLabs.astro, lib/labs.ts). Pass `welcome` (a few
// sentences) and a first-time visitor is greeted with them in a dialog, once per lab.
import '../styles/lab.css';
import DisplaySettings from '../components/DisplaySettings.astro';
import DisplaySettingsInit from '../components/DisplaySettingsInit.astro';
import AboutLink from '../components/AboutLink.astro';
import BarButton from '../components/BarButton.astro';
import LabWelcome from '../components/LabWelcome.astro';
import MoreLabs from '../components/MoreLabs.astro';
import { DEV_ANALYTICS } from '../lib/kylepace-dev';

interface Props {
  title: string;
  description: string;
  /** Share image, as a path on kylepace.dev ("/transit/share.png") or a full URL. */
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Favicon path; defaults to kylepace.dev's. */
  favicon?: string;
  /** Browser UI color in light and dark mode. Defaults to the tokens' backgrounds. */
  themeColor?: { light: string; dark: string };
  /** Where the back link goes, and what it says. */
  backHref?: string;
  backLabel?: string;
  /** The lab's About page ("/transit/about/"). Shows the "About this project" button. */
  about?: string;
  /**
   * The lab's name and main page. On every other page of the lab (About, a technical
   * page, a directory), the bar starts with "Back to <name>", and the tab title says
   * which lab the page belongs to.
   */
  lab?: { name: string; href: string };
  /**
   * One to three sentences shown in a welcome dialog on a visitor's first visit: what the
   * experiment is and what to try. Titled with `lab.name` (or the page title) unless you
   * pass `{ name, text }`, for labs whose `lab.name` reads as "Back to the search".
   * Links to `about`.
   */
  welcome?: string | { name: string; text: string };
  noindex?: boolean;
  /**
   * For a project that has grown out of kylepace.dev onto its own domain (Findish at
   * findish.now): its name for tab titles and share cards, its own Amplitude project and
   * live hosts, and its own footer links. Leave it out on kylepace.dev and everything
   * stays as it was.
   */
  site?: {
    name: string;
    analytics: { apiKey: string; liveHosts: string[] };
    footer: { href: string; label: string }[];
    accessibilityHref: string;
  };
  /** Short form of the back label on phones. */
  backShort?: string;
  /**
   * Show the top bar of buttons (back, More labs, About this project). A standalone
   * project on its own domain can turn it off and link from its footer instead.
   */
  bar?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  favicon = '/favicon.svg',
  themeColor = { light: '#fbf8f3', dark: '#141317' },
  backHref = 'https://kylepace.dev/labs/',
  backLabel = 'More labs by Kyle',
  about,
  lab,
  welcome,
  noindex = false,
  site: own,
  backShort = 'More labs',
  bar = true,
} = Astro.props;

const siteName = own?.name ?? 'kylepace.dev';
const analytics = own?.analytics ?? DEV_ANALYTICS;
const footer = own?.footer ?? [
  { href: 'https://kylepace.dev/privacy/', label: 'Privacy' },
  { href: 'https://kylepace.dev/accessibility/', label: 'Accessibility' },
  { href: 'https://kylepace.dev/connections/', label: 'Connections' },
];
const accessibilityHref = own?.accessibilityHref ?? 'https://kylepace.dev/accessibility/';

const trim = (p: string) => p.replace(/\/+$/, '');
const here = trim(Astro.url.pathname);
const onAbout = !!about && here === trim(about);
const onLabHome = !!lab && here === trim(new URL(lab.href, 'https://kylepace.dev').pathname);
const showBack = !!lab && !onLabHome;
const showAbout = !!about && !onAbout;
// Three buttons don't fit a phone's width at full length, so "More labs by Kyle" also
// shortens then. With two, it keeps "by Kyle": the only credit in view on a phone.
const crowded = showBack && showAbout;
const labSlug = lab ? trim(new URL(lab.href, 'https://kylepace.dev').pathname).split('/').pop() : undefined;

const site = Astro.site ?? new URL('https://kylepace.dev');
const canonical = new URL(Astro.url.pathname, site);
// A lab's title stands on its own; the site name follows, so tabs still say where it lives.
// A subpage also names its lab ("Transit agencies · World transit · kylepace.dev"),
// unless its title already does ("About World transit").
// On its own domain, a title that already names the site stands alone ("About Findish").
const pageTitle =
  own && title.toLowerCase().includes(siteName.toLowerCase())
    ? title
    : lab && !onLabHome && !title.toLowerCase().includes(lab.name.toLowerCase())
      ? `${title} · ${lab.name} · ${siteName}`
      : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={favicon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL(image, site)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="fediverse:creator" content="@kylepace@mastodon.social" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <slot name="head" />
    <DisplaySettingsInit />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {bar && (
    <header class="lab-head">
      <nav class="lab-bar" aria-label="Lab">
        <div class="lab-bar-start">
          {showBack && lab && <BarButton href={lab.href} icon="back" label={`Back to ${lab.name}`} short="Back" back />}
          <BarButton href={backHref} icon="labs" label={backLabel} short={backShort} quiet shortOnPhones={crowded} />
        </div>
        <div class="lab-bar-end">
          <slot name="bar" />
          {showAbout && <AboutLink href={about!} />}
        </div>
      </nav>
    </header>
    )}
    <main id="main" tabindex="-1">
      <slot />
      {onAbout && labSlug && <MoreLabs slug={labSlug} />}
    </main>
    <footer class="lab-foot">
      <p>Made by <a href="https://kylepace.net/">Kyle Pace</a>.</p>
      <nav aria-label="Elsewhere">
        <ul>
          {footer.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </footer>
    <DisplaySettings accessibilityHref={accessibilityHref} />
    {
      welcome && !onAbout && (
        <LabWelcome
          name={typeof welcome === 'string' ? (lab?.name ?? title) : welcome.name}
          text={typeof welcome === 'string' ? welcome : welcome.text}
          about={about}
        />
      )
    }
    <script is:inline type="application/json" id="kp-analytics" set:html={JSON.stringify(analytics)} />
    <script>
      import { startAnalytics } from '../lib/analytics';
      import { DEV_ANALYTICS } from '../lib/kylepace-dev';
      // The page's own project (set by `site`), or kylepace.dev's.
      let options = DEV_ANALYTICS;
      try {
        options = JSON.parse(document.getElementById('kp-analytics')?.textContent || '') ?? DEV_ANALYTICS;
      } catch {}
      startAnalytics(options);

      // "Back to <lab>" goes back in history when the page before was the lab itself, so
      // a search, a map view or a scroll position comes back as it was. Otherwise (a
      // shared link, a new tab) it's a plain link to the lab.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-back]')) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          try {
            const before = new URL(document.referrer);
            const target = new URL(link.href);
            const trimmed = (p: string) => p.replace(/\/+$/, '');
            if (before.origin === location.origin && trimmed(before.pathname) === trimmed(target.pathname) && history.length > 1) {
              event.preventDefault();
              history.back();
            }
          } catch {
            // No referrer: follow the link.
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* On a narrow phone, a lab's own links and the About button wrap under the back link
     instead of pushing the page sideways. */
  .lab-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) var(--gutter);
  }


  /* On the About page, "Back to <lab>" comes first, where back always is, with
     "More labs by Kyle" beside it. */
  .lab-bar-start {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: center;
  }

  .lab-bar-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    align-items: center;
    margin-inline-start: auto;
  }

  /* The skip link lands on <main> (tabindex -1, so Safari moves focus too); it isn't a
     control, so no focus ring. */
  main:focus {
    outline: none;
  }

  .lab-foot {
    padding: var(--space-8) var(--gutter) calc(var(--space-8) + 4rem);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .lab-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
  }

  .lab-foot p,
  .lab-foot ul {
    margin: 0;
  }

  .lab-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .lab-foot a {
    color: inherit;
  }
</style>
