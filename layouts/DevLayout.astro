---
// The page shell for kylepace.dev and every experiment on it: head and share-card tags,
// the kylepace.dev header and footer, display settings and analytics. Change the shared
// links in lib/kylepace-dev.ts and every site picks them up on its next kp-design update.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisplaySettings from '../components/DisplaySettings.astro';
import DisplaySettingsInit from '../components/DisplaySettingsInit.astro';
import { DEV_NAV, DEV_FOOTER } from '../lib/kylepace-dev';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
  /** Share image, as a path on kylepace.dev ("/transit/share.png") or a full URL. */
  image?: string;
  imageAlt?: string;
  /** Pixel size of the share image, when it isn't the usual 1200 by 630 card. */
  imageWidth?: number;
  imageHeight?: number;
  /** Keep this page out of search engines. */
  noindex?: boolean;
}

const {
  title,
  description = 'Experiments by Kyle Pace: small, playful things he’s building and refining in public.',
  accent,
  image = '/og-default.png',
  imageAlt = 'kylepace.dev: experiments by Kyle Pace, in progress.',
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://kylepace.dev');
const siteName = 'kylepace.dev';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL(image, site)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="fediverse:creator" content="@kylepace@mastodon.social" />
    <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141317" media="(prefers-color-scheme: dark)" />
    <slot name="head" />
    <DisplaySettingsInit />
  </head>
  <body data-accent={accent}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header name="kylepace" suffix=".dev" mono href="https://kylepace.dev/" links={DEV_NAV} />
    <main id="main">
      <slot />
    </main>
    <Footer links={DEV_FOOTER} />
    <DisplaySettings accessibilityHref="https://kylepace.dev/accessibility/" />
    <script>
      import { startAnalytics } from '../lib/analytics';
      import { DEV_ANALYTICS } from '../lib/kylepace-dev';
      startAnalytics(DEV_ANALYTICS);
    </script>
  </body>
</html>
